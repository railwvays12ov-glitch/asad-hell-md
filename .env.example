# Optional API keys
SCREENSHOT_API_KEY=
DOWNLOADER_API=https://youtube-dwn.up.railway.app/api/download
AI_API=https://gemini-api-from-ammar.vercel.app/api/ask

# Session folder (Railway par Volume lagayein taake session restart ke baad bhi rahe)
AUTH_DIR=./auth_info
DATA_DIR=./data
