# Copy this file to .env (local) or add these as Railway Variables

# Bot ka naam
BOT_NAME=Asad Hell MD

# Owner number (country code ke saath, bina + ke)
OWNER_NUMBER=923013600709

# Pairing code ke liye number (optional). Set karein to QR ki jagah pairing code milega.
